# Copy to .env.local for local development. Placeholders only — never commit real values.

# Public base URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" ONLY on the approved production domain. Staging must stay "false".
SITE_INDEXABLE=false

# Local file-based lead store (development only; git-ignored). Replaced by PostgreSQL in Phase 6.
LEAD_STORE_DIR=.data

# Lead notification adapter: "console" (logs opaque reference only), "none" or "webhook".
LEAD_NOTIFIER=console

# Required only when LEAD_NOTIFIER=webhook. Must be https (http allowed for localhost/127.0.0.1 only).
# The full enquiry (name, email, phone, message...) is POSTed as JSON to this destination.
# LEAD_WEBHOOK_URL=https://example.invalid/hooks/leads
# Optional: when set, requests carry X-Medhavya-Signature: sha256=<hex HMAC-SHA256 of the raw body>.
# LEAD_WEBHOOK_SECRET=change-me

# Max lead submissions per client IP per 10 minutes.
LEAD_RATE_LIMIT_PER_10_MIN=5
