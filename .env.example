# Copy to .env.local for local development. Placeholders only — never commit real values.

# Public base URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" ONLY on the approved production domain. Staging must stay "false".
SITE_INDEXABLE=false

# Local file-based lead store (development only; git-ignored). Replaced by PostgreSQL in Phase 6.
LEAD_STORE_DIR=.data

# Lead notification adapter: "console" (logs opaque reference only) or "none".
LEAD_NOTIFIER=console

# Max lead submissions per client IP per 10 minutes.
LEAD_RATE_LIMIT_PER_10_MIN=5
