{
  "name": "medhavya-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "brand:assets": "node scripts/prepare-brand-assets.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "cms:migrate": "tsx scripts/cms-migrate.mts up",
    "cms:seed": "tsx scripts/cms-seed.mts",
    "cms:publish": "tsx scripts/cms-publish.mts",
    "cms:migrate:create": "tsx scripts/cms-migrate.mts create"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.93.0",
    "@payloadcms/next": "^3.93.0",
    "@payloadcms/richtext-lexical": "^3.93.0",
    "clsx": "^2.1.1",
    "graphql": "^16.15.0",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "payload": "^3.93.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
